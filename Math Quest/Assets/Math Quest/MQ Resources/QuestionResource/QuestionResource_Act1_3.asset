  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_3
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: Translating Verbal Phrases into Algebraic Expressions
  question: "The quotient of four less than the square of a number $x$, and the sum of three times $y$ and two, increased by the cube of twice the difference of $x$ and $y$."
  answer: {fileID: 11400000, guid: 0b0cc9b1d4054071a28d2cd35e4d4d0a, type: 2}
  encourageDialogue:
  - Excellent! You built it perfectly.
  tauntDialogue:
  - Hehehe... that expression is not right!
  solutionDialogue:
  - "Break the sentence into parts. 'Four less than the square of x' means x<sup>2</sup> - 4."
  - "'The sum of three times y and two' is 3y + 2."
  - "'The quotient of' these two parts makes a fraction: (x<sup>2</sup> - 4)/(3y + 2)."
  - "'The cube of twice the difference of x and y' is [2(x - y)]<sup>3</sup>."
  - "'Increased by' means add, so join the fraction and the cube with a plus sign."
