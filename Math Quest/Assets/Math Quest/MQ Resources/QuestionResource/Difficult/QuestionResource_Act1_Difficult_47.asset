  act: 1
  difficulty: 2
  topic: "Components of Algebraic Expressions"
  question: "In $2a-3b+4c-5d$, what is the coefficient of $d$?"
  answer: {fileID: 11400000, guid: 3161572c19934fa4af8408ae7f6058cb, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "The coefficient is the number multiplied by the variable part, sign included."
  - "For $-5d$ it is $-5$."
