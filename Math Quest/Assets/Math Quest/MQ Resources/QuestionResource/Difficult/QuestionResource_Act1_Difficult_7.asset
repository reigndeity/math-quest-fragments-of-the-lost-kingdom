  act: 1
  difficulty: 2
  topic: "Classifying Algebraic Expressions"
  question: "Given the algebraic expression $-4x^3+9x-5$, classify it based on its number of terms (Monomial, Binomial, or Trinomial)."
  answer: {fileID: 11400000, guid: 7ea4a6f825375b37a3c5b4e9995639df, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "The terms are $-4x^3$, $9x$ and $-5$."
  - "Three terms make a trinomial."
