  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Eleven subtracted from the product of a number $x$ and negative three."
  answer: {fileID: 11400000, guid: 2bc7307eeea8430d9e21169ef37b6e7c, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $-3x-11$."
