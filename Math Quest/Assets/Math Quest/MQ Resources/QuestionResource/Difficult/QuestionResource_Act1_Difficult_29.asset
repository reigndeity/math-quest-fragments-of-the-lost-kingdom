  m_Name: QuestionResource_Act1_Difficult_29
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: Evaluating Algebraic Expressions
  question: Evaluate $4p^2-3(q-r)^2+2qr$ when $p=-2$, $q=3$ and $r=-1$.
  answer: {fileID: 11400000, guid: 1d88a25e039a4bf48ef33d554e711e2f, type: 2}
  askedByGuide: {fileID: 0}
  explainedByGuide: {fileID: 11400000, guid: 83ff694a7788da24498d14928bc1a0d3, type: 2}
  encourageDialogue:
  - Impressive! That is correct.
  tauntDialogue:
  - Hehehe... that is not right!
  solutionDialogue:
  - 'Replace each letter with its value: $4(-2)^2-3((3)-(-1))^2+2(3)(-1)$.'
  - Work it out step by step. The result is $-38$.
