  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_Difficult_26
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The square of the quotient of twice $m$ and the sum of $n$ and five, increased by seven subtracted from the product of $m$ and $n$ cubed."
  answer: {fileID: 11400000, guid: bbe5753947c643b6b973edac655bdd47, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $(\\frac{2m}{n+5})^2+(mn^3-7)$."
