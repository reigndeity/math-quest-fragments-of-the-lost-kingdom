  act: 1
  difficulty: 2
  topic: "Components of Algebraic Expressions"
  question: "How many terms does the expression $-9m^4+5m^3n-7mn^3+n^4-2$ contain?"
  answer: {fileID: 11400000, guid: a9e5115e134c4e31a3f4361289114fb7, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Terms are the parts separated by $+$ and $-$ signs."
  - "Counting them gives 5 terms."
