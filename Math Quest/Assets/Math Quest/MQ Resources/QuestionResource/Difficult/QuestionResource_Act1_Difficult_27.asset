  m_Name: QuestionResource_Act1_Difficult_27
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Three times the cube of the difference of $p$ and $q$, decreased by the quotient of eight less than the product of seven and $p$, and the sum of $q$ and four."
  answer: {fileID: 11400000, guid: ede44e607c8b44e59edef9f283c1bd66, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $3(p-q)^3-\\frac{7p-8}{q+4}$."
