  act: 1
  difficulty: 2
  topic: "Components of Algebraic Expressions"
  question: "In the expression $x-2y+3z-4$, what is the constant term?"
  answer: {fileID: 11400000, guid: 6f2e32838a9640ebbea7bb5c543d983e, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "A constant term has no variable."
  - "Here it is $-4$."
