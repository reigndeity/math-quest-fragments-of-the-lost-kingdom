  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_Difficult_38
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Components of Algebraic Expressions"
  question: "In the expression $-8a^2b+6ab^2-13a+9$, what is the numerical coefficient of the term $-8a^2b$?"
  answer: {fileID: 11400000, guid: 9651634e66ef49c9b55ac5a821fe36a8, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "The numerical coefficient is the number part of the term, sign included."
  - "For $-8a^2b$ it is $-8$."
