  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $3(a+4)-\\frac{b}{5}$ when $a=-6$ and $b=15$."
  answer: {fileID: 11400000, guid: e105124a0d9f58c8a8c75ffffa4a08e9, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace the letters: $3(-6+4)-\\frac{15}{5}$."
  - "$3(-2)-3$."
  - "$-6-3=-9$."
