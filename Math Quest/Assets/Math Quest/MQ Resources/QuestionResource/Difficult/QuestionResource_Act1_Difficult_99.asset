  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $4(a+5)-\\frac{b}{6}$ when $a=-7$ and $b=18$."
  answer: {fileID: 11400000, guid: f3764e047f474fb0a50134ceec078f46, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Replace each letter with its value: $4((-7)+5)-\\frac{(18)}{6}$."
  - "Work it out step by step. The result is $-11$."
