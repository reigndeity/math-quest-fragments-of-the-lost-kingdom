  m_Name: QuestionResource_Act1_Difficult_10
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Components of Algebraic Expressions"
  question: "What is the numerical coefficient of the first term in the expression below? $-\\frac{5x^3y}{8}+2x-9$"
  answer: {fileID: 11400000, guid: 88df9250d1085f00bbd93fd7e63cd2fa, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "The first term is $-\\frac{5x^3y}{8}$."
  - "Remove the variables and keep the sign: $-\\frac{5}{8}$."
