  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Nine subtracted from the product of a number $x$ and negative two."
  answer: {fileID: 11400000, guid: d579240b47c9434486f8cb535a655525, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $-2x-9$."
