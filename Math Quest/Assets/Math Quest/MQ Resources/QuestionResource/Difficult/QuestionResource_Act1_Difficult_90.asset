  m_Name: QuestionResource_Act1_Difficult_90
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: Components of Algebraic Expressions
  question: What is the numerical coefficient of the term $-6y^5$ in the expression
    $x^3-6y^5+14$?
  answer: {fileID: 11400000, guid: 5aa053fa74d6444ebc81edc744088ef2, type: 2}
  askedByGuide: {fileID: 0}
  explainedByGuide: {fileID: 11400000, guid: 83ff694a7788da24498d14928bc1a0d3, type: 2}
  encourageDialogue:
  - Hmph... correct. Lucky guess?
  tauntDialogue:
  - Wrong! Better luck next time.
  solutionDialogue:
  - The numerical coefficient is the number part of the term, sign included.
  - For $-6y^5$ it is $-6$.
