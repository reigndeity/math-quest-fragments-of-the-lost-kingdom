  topic: "Components of Algebraic Expressions"
  question: "How many terms are in the expression $-3x^4y^5+x^7-y^6+21$?"
  answer: {fileID: 11400000, guid: 68053f5b398c48a7bf353a819a2115a4, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Terms are the parts separated by $+$ and $-$ signs."
  - "Counting them gives 4 terms."
