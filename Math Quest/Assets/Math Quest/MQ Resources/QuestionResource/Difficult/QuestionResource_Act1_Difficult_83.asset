  m_Name: QuestionResource_Act1_Difficult_83
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: Evaluating Algebraic Expressions
  question: Evaluate $\frac{4p^2q-r^2}{3p+q}$ when $p=-2$, $q=3$ and $r=-4$.
  answer: {fileID: 11400000, guid: 19fce05fd8e84d54936e663f6503e878, type: 2}
  askedByGuide: {fileID: 0}
  explainedByGuide: {fileID: 11400000, guid: 83ff694a7788da24498d14928bc1a0d3, type: 2}
  encourageDialogue:
  - Well done! You got it right.
  tauntDialogue:
  - Nope! Not even close.
  solutionDialogue:
  - 'Replace each letter with its value: $\frac{4(-2)^2(3)-(-4)^2}{3(-2)+(3)}$.'
  - Work it out step by step. The result is $-\frac{32}{3}$.
