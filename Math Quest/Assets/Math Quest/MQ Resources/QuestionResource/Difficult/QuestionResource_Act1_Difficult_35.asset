  act: 1
  difficulty: 2
  topic: "Components of Algebraic Expressions"
  question: "In the algebraic expression $7x^2-5x+12$, identify the coefficient of the term containing $x^2$."
  answer: {fileID: 11400000, guid: 2285bbe304a7476ea43082436d1d4f70, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Find the term with $x^2$ and read the number in front of it."
  - "That number is $7$."
