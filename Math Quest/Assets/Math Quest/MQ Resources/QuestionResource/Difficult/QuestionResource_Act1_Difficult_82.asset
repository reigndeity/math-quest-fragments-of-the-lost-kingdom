  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $m^3-n^3+m^2n$ when $m=-1$ and $n=3$."
  answer: {fileID: 11400000, guid: 4e42c706dd794e01b9dc87ee22925377, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Replace each letter with its value: $(-1)^3-(3)^3+(-1)^2(3)$."
  - "Work it out step by step. The result is $-25$."
