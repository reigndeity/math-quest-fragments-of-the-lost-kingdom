  m_Name: QuestionResource_Act1_Difficult_46
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Components of Algebraic Expressions"
  question: "In the expression $6+5w$, what is the coefficient of $w$?"
  answer: {fileID: 11400000, guid: 7bc3925726914afda9ea2af7efb93313, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "The coefficient is the number multiplied by the variable part, sign included."
  - "For $5w$ it is $5$."
