  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $3(b-a)^2-4c+a^3$ when $a=-2$, $b=3$ and $c=5$."
  answer: {fileID: 11400000, guid: 5817aa5ec3a9524389c3c8e1902f833f, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Replace the letters: $3(3-(-2))^2-4(5)+(-2)^3$."
  - "$3(5)^2-20-8$."
  - "$75-20-8=47$."
