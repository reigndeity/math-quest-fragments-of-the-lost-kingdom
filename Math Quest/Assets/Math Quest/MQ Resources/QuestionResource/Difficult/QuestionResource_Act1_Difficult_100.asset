  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $3pq^3+(p-8)^2$ when $p=2$ and $q=-3$."
  answer: {fileID: 11400000, guid: 94ce84b3ffaa4eff921cbb280d9070f2, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace each letter with its value: $3(2)(-3)^3+((2)-8)^2$."
  - "Work it out step by step. The result is $-126$."
