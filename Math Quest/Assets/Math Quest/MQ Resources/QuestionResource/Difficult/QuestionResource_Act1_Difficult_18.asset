  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $(2x-3)^2-4y$ when $x=5$ and $y=-2$."
  answer: {fileID: 11400000, guid: d579ba50b0145e79b18099431d3905f1, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Replace the letters: $(2(5)-3)^2-4(-2)$."
  - "$7^2+8$."
  - "$49+8=57$."
