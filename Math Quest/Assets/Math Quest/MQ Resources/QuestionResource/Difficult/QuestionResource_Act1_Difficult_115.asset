  act: 1
  difficulty: 2
  topic: "Components of Algebraic Expressions"
  question: "In $-m^2+8m-12$, what is the coefficient of $m^2$?"
  answer: {fileID: 11400000, guid: 88d126eb49df4d52ae5930599eaa8e5b, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "The coefficient is the number multiplied by the variable part, sign included."
  - "For $-m^2$ it is $-1$."
