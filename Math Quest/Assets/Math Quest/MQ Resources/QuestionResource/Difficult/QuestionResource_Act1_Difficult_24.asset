  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_Difficult_24
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Components of Algebraic Expressions"
  question: "How many terms are in the unexpanded algebraic expression below? $-2(3a-b)^2+\\frac{a+4}{5}-11$"
  answer: {fileID: 11400000, guid: 1b475f6c05b15534afc7611939dae625, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Terms are the parts separated by + and - signs."
  - "$-2(3a-b)^2$, $\\frac{a+4}{5}$ and $-11$ make 3 terms. Do not expand the parentheses."
