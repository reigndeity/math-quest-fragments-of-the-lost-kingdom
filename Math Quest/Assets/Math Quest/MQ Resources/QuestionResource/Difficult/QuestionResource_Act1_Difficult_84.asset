  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_Difficult_84
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The square of four less than three times a number $x$, decreased by the quotient of six times $y$ and the quantity two more than $x$, all increased by one-third the difference of $x$ and $y$."
  answer: {fileID: 11400000, guid: d39da33dc4c34074a30ecea46ce43868, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $(3x-4)^2-\\frac{6y}{x+2}+\\frac{x-y}{3}$."
