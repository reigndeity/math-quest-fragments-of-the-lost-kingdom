  m_Name: QuestionResource_Act1_Difficult_118
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: Components of Algebraic Expressions
  question: In the expression $10-5r+r^2$, what is the coefficient of $r$?
  answer: {fileID: 11400000, guid: 89f8f72efe0d4efe94dac1c6c124737a, type: 2}
  askedByGuide: {fileID: 0}
  explainedByGuide: {fileID: 11400000, guid: 83ff694a7788da24498d14928bc1a0d3, type: 2}
  encourageDialogue:
  - Hmph... correct. Lucky guess?
  tauntDialogue:
  - Wrong! Better luck next time.
  solutionDialogue:
  - The coefficient is the number multiplied by the variable part, sign included.
  - For $-5r$ it is $-5$.
