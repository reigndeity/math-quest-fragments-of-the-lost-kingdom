  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $6x-3y+2z$ when $x=\\frac{1}{2}$, $y=4$ and $z=-3$."
  answer: {fileID: 11400000, guid: 14c30ff89c3d4e88aabcbe12c203075c, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Replace each letter with its value: $6(\\frac{1}{2})-3(4)+2(-3)$."
  - "Work it out step by step. The result is $-15$."
