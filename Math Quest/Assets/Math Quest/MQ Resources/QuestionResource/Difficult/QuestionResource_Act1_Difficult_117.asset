  topic: "Components of Algebraic Expressions"
  question: "In the term $-18abc$, what is the coefficient?"
  answer: {fileID: 11400000, guid: b3a27d3ed67340f494785ccf2d30b734, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "The coefficient is the number multiplied by the variable part, sign included."
  - "For $-18abc$ it is $-18$."
