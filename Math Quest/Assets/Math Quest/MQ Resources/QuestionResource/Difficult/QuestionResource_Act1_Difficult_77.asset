  m_Name: QuestionResource_Act1_Difficult_77
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $\\frac{m-n}{m+n}$ when $m=6$ and $n=2$."
  answer: {fileID: 11400000, guid: 9ee15bd76af74392856fca80a7f4e141, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace each letter with its value: $\\frac{(6)-(2)}{(6)+(2)}$."
  - "Work it out step by step. The result is $\\frac{1}{2}$."
