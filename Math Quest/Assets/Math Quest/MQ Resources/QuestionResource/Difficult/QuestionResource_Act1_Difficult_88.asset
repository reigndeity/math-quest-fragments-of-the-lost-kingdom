  topic: "Components of Algebraic Expressions"
  question: "What are the constant terms in the expression $-\\frac{5x^3}{2}+9x-18$?"
  answer: {fileID: 11400000, guid: 8886f66d869a4931b893f0c533843b68, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "A constant term has no variable."
  - "Only $-18$ qualifies."
