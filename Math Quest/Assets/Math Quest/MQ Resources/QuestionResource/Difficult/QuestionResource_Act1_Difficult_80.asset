  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_Difficult_80
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The quotient of three less than the square of a number $x$, and the sum of four times $y$ and five, increased by the cube of the difference of $x$ and $y$."
  answer: {fileID: 11400000, guid: d53c2c3173624b8fb3f989a708be56d0, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $\\frac{x^2-3}{4y+5}+(x-y)^3$."
