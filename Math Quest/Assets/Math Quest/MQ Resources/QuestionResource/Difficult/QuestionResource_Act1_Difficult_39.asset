  act: 1
  difficulty: 2
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate: \"Five times the difference between the square of the sum of $a$ and $b$, and their product.\""
  answer: {fileID: 11400000, guid: 65b1a120d4494c4482c853832aa37115, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $5[(a+b)^2-ab]$."
