  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $\\frac{x^2}{3}-2(x-5)$ when $x=-3$."
  answer: {fileID: 11400000, guid: 15290ba711a15df885377b50509e3097, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Replace $x$ with $-3$: $\\frac{(-3)^2}{3}-2(-3-5)$."
  - "$\\frac{9}{3}-2(-8)$."
  - "$3+16=19$."
