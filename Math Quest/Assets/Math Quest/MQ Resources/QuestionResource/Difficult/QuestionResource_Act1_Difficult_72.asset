  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $-2p^3+4p$ when $p=-1$."
  answer: {fileID: 11400000, guid: 77d9f736d811402b88870258724e8e77, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace each letter with its value: $-2(-1)^3+4(-1)$."
  - "Work it out step by step. The result is $-2$."
