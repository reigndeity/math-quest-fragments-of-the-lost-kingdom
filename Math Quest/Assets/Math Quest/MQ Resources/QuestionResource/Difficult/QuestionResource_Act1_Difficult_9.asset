  act: 1
  topic: "Components of Algebraic Expressions"
  question: "What are the constant terms in the expression below? $-\\frac{4x^2}{3}+7x-15$"
  answer: {fileID: 11400000, guid: ddb4111b99bf5ca6a510a980a53a7d98, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "A constant term has no variable."
  - "Only $-15$ qualifies."
