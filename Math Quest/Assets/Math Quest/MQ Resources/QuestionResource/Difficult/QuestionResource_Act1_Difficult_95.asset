  act: 1
  difficulty: 2
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Four times the quantity six more than a number $a$, decreased by the quotient of $b$ and seven."
  answer: {fileID: 11400000, guid: 060a1f477a124ec290a844e1fe625881, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $4(a+6)-\\frac{b}{7}$."
