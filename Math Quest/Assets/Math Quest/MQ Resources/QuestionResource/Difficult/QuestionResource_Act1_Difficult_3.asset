  m_Name: QuestionResource_Act1_Difficult_3
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: Evaluating Algebraic Expressions
  question: Evaluate $\frac{m^2-n^2}{m+n}+m^3$ when $m=-2$ and $n=5$.
  answer: {fileID: 11400000, guid: eba8abcb56e550cb8820f52902867bef, type: 2}
  askedByGuide: {fileID: 0}
  explainedByGuide: {fileID: 11400000, guid: 83ff694a7788da24498d14928bc1a0d3, type: 2}
  encourageDialogue:
  - Well done! You got it right.
  tauntDialogue:
  - Nope! Not even close.
  solutionDialogue:
  - 'Replace the letters: $\frac{(-2)^2-5^2}{-2+5}+(-2)^3$.'
  - $\frac{4-25}{3}+(-8)$.
  - $-7-8=-15$.
