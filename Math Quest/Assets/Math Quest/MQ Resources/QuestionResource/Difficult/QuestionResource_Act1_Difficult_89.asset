  m_Name: QuestionResource_Act1_Difficult_89
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: Components of Algebraic Expressions
  question: What is the numerical coefficient of the first term in the expression
    $-7x^4y^6+3x-11$?
  answer: {fileID: 11400000, guid: 478edde7f092417b82d7f0c3183913d9, type: 2}
  askedByGuide: {fileID: 0}
  explainedByGuide: {fileID: 11400000, guid: 83ff694a7788da24498d14928bc1a0d3, type: 2}
  encourageDialogue:
  - Impressive! That is correct.
  tauntDialogue:
  - Hehehe... that is not right!
  solutionDialogue:
  - The numerical coefficient is the number part of the term, sign included.
  - For $-7x^4y^6$ it is $-7$.
