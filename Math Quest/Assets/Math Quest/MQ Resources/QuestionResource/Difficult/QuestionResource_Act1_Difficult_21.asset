  m_Name: QuestionResource_Act1_Difficult_21
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $2pq^3+\\frac{p-7}{2}$ when $p=3$ and $q=-2$."
  answer: {fileID: 11400000, guid: fdedb1fb4f6d504697a9a0285cea9197, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace the letters: $2(3)(-2)^3+\\frac{3-7}{2}$."
  - "$6(-8)+\\frac{-4}{2}$."
  - "$-48-2=-50$."
