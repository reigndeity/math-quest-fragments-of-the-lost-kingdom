  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_Difficult_14
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 2
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The square of three less than twice a number $x$, decreased by four times $y$."
  answer: {fileID: 11400000, guid: cbba634d3267577188582530bb76454d, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Three less than twice $x$ is $2x-3$, and its square is $(2x-3)^2$."
  - "Decreased by four times $y$ means subtract $4y$."
  - "So: $(2x-3)^2-4y$."
