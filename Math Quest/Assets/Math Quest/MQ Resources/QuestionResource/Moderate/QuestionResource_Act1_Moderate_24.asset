  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $x^3+4y$ when $x=2$ and $y=5$."
  answer: {fileID: 11400000, guid: c233484358d5572692a9a9abfc416e4d, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace $x$ with 2 and $y$ with 5: $2^3+4(5)$."
  - "$8+20=28$."
