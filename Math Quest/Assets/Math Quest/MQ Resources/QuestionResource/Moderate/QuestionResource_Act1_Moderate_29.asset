  topic: "Components of Algebraic Expressions"
  question: "In the expression $14-5x^2+x$, what is the constant term?"
  answer: {fileID: 11400000, guid: 929c064f639a4c098fdad0d69e110ba6, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "A constant term has no variable."
  - "Here it is $14$."
