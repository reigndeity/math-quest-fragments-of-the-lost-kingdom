  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The quotient of a number $n$ and 5, increased by 12."
  answer: {fileID: 11400000, guid: dc54fbd80d1d45de824ccf7058959a4d, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $\\frac{n}{5}+12$."
