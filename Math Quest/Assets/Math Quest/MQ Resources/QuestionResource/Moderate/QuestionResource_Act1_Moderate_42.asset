  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $3(a+4b)$ when $a=6$ and $b=-2$."
  answer: {fileID: 11400000, guid: a220de5cc07b486a85674b846f06c56d, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Replace each letter with its value: $3((6)+4(-2))$."
  - "Work it out step by step. The result is $-6$."
