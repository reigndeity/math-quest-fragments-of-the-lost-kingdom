  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $\\frac{x+2y}{3}$ when $x=4$ and $y=1$."
  answer: {fileID: 11400000, guid: 602d9d7afb024a08b98ca14f46508cbd, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace each letter with its value: $\\frac{(4)+2(1)}{3}$."
  - "Work it out step by step. The result is $2$."
