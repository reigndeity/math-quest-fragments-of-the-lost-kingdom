  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $3x^2+4xy-2y^2$ when $x=5$ and $y=2$."
  answer: {fileID: 11400000, guid: 3fbb2684d9724c759f3d3c5f23d455ed, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace each letter with its value: $3(5)^2+4(5)(2)-2(2)^2$."
  - "Work it out step by step. The result is $107$."
