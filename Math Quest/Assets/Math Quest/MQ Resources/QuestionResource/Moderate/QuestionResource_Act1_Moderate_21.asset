  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The sum of five times a number $y$ and the square of $y$."
  answer: {fileID: 11400000, guid: 1bec4c8c25e45bc79fdbbe6e2f9bc2df, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Five times $y$ is $5y$, and the square of $y$ is $y^2$."
  - "The sum means add: $5y+y^2$."
