  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $2a^2-5b$ when $a=3$ and $b=4$."
  answer: {fileID: 11400000, guid: 678c53048fc1515fa102db90f045abb1, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace $a$ with 3 and $b$ with 4: $2(3)^2-5(4)$."
  - "$18-20=-2$."
