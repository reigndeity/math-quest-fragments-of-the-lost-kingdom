  m_Name: QuestionResource_Act1_Moderate_1
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $x^2-y^2+2xy$ when $x=3$ and $y=4$."
  answer: {fileID: 11400000, guid: 3cdc08f93b4553989685719d793b42f4, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace $x$ with 3 and $y$ with 4: $3^2-4^2+2(3)(4)$."
  - "$9-16+24=17$."
