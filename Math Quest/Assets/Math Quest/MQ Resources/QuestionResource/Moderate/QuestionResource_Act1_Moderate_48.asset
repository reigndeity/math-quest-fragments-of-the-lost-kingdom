  act: 1
  difficulty: 1
  topic: "Components of Algebraic Expressions"
  question: "How many terms are in the algebraic expression $4a^2-7ab+2b-9$?"
  answer: {fileID: 11400000, guid: 84999c214e204812ae359227d33b8c35, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Terms are the parts separated by $+$ and $-$ signs."
  - "Counting them gives 4 terms."
