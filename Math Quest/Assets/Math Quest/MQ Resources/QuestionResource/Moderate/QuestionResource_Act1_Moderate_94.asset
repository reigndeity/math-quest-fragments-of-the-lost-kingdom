  m_Name: QuestionResource_Act1_Moderate_94
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Write an expression for: \"One-half of the sum of a number $m$ and 6.\""
  answer: {fileID: 11400000, guid: 0eb7ba82d1864cfba5e6e84cef5c3b1f, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $\\frac{m+6}{2}$."
