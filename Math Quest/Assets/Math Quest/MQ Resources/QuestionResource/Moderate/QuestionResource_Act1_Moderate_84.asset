  act: 1
  difficulty: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate to algebra: \"Three times the sum of a number $a$ and 4.\""
  answer: {fileID: 11400000, guid: e0cb1e5383584724990b5f901e09fdb9, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $3(a+4)$."
