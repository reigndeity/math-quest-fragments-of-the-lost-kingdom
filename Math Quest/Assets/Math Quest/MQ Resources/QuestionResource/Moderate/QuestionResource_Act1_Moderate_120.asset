  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Eight more than the quotient of a number $y$ and 5."
  answer: {fileID: 11400000, guid: 7e0dba6a850646bb897c5d7050422fb1, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $\\frac{y}{5}+8$."
