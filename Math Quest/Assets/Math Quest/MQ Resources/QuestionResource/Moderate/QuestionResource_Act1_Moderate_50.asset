  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $4x^2-3xy+y$ when $x=2$ and $y=5$."
  answer: {fileID: 11400000, guid: a098811930f04c99b3f1a7a0d26128de, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Replace each letter with its value: $4(2)^2-3(2)(5)+(5)$."
  - "Work it out step by step. The result is $-9$."
