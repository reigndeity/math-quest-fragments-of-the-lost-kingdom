  act: 1
  difficulty: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The quotient of a number $n$ and 4, subtracted from twice the square of $n$."
  answer: {fileID: 11400000, guid: 4bd660aacaa358efa3aaa4298a6b089f, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "The quotient of $n$ and 4 is $\\frac{n}{4}$."
  - "Twice the square of $n$ is $2n^2$."
  - "Subtract the quotient from it: $2n^2-\\frac{n}{4}$."
