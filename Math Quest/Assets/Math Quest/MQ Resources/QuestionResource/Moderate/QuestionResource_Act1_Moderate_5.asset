  act: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Five more than the product of negative two and the square of $x$."
  answer: {fileID: 11400000, guid: a55455dda90e5e7ca119bfaf77cbac09, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "The product of negative two and the square of $x$ is $-2x^2$."
  - "Five more than it means add 5: $-2x^2+5$."
