  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Four less than the quotient of a number $n$ and 6."
  answer: {fileID: 11400000, guid: a64aa5f7117c4501b9878dafbf8fd6c4, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $\\frac{n}{6}-4$."
