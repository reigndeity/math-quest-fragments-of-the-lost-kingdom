  act: 1
  difficulty: 1
  topic: "Components of Algebraic Expressions"
  question: "How many terms are in the algebraic expression $6x^4-3x^2+8x-1$?"
  answer: {fileID: 11400000, guid: 56ddd153b6c34c45814650849c1f7b5d, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Terms are the parts separated by $+$ and $-$ signs."
  - "Counting them gives 4 terms."
