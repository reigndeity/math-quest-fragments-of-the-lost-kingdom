  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $10-2a^3+b$ when $a=-1$ and $b=4$."
  answer: {fileID: 11400000, guid: bd72aaf022a04f1aa07baf8ca08a17ef, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace each letter with its value: $10-2(-1)^3+(4)$."
  - "Work it out step by step. The result is $16$."
