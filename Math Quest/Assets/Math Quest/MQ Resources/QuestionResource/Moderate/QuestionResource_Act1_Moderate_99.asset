  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "The quotient of a number $n$ and 8, decreased by 6."
  answer: {fileID: 11400000, guid: 81dc3b26500c4fea95c511d11a50277c, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $\\frac{n}{8}-6$."
