  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Seven less than twice a number $n$."
  answer: {fileID: 11400000, guid: 152051b157225a5ab0c7df8d4ec5730d, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Twice a number is $2n$."
  - "Seven less than it means subtract 7 from it: $2n-7$."
