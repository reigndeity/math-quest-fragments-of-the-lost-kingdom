  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Eight subtracted from the product of 3 and a number $b$."
  answer: {fileID: 11400000, guid: 3436ccda9b3c58d19dd8a03050868f9e, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "The product of 3 and $b$ is $3b$."
  - "Eight subtracted from it: $3b-8$."
