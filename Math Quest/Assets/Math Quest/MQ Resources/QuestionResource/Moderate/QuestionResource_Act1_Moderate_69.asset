  m_Name: QuestionResource_Act1_Moderate_69
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  difficulty: 1
  topic: "Components of Algebraic Expressions"
  question: "In the expression $7m^3-2m+11$, identify the coefficient of the middle term."
  answer: {fileID: 11400000, guid: 290eddb9ef944eec9eecd21f1f0f6a33, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "The middle term is the second term. Its coefficient is the number in front of the variable part."
  - "Here that number is $-2$ (keep its sign)."
