  act: 1
  difficulty: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Three-fourths of a number $t$, added to the product of 2 and $t$."
  answer: {fileID: 11400000, guid: 8fbe0b2a45c8430dafa02c14edf2a078, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
  tauntDialogue:
  - "Wrong! Better luck next time."
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $\\frac{3}{4}t+2t$."
