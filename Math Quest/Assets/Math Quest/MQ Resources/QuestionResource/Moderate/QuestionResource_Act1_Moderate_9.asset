  topic: "Components of Algebraic Expressions"
  question: "In the expression $9-3y^2+y$, what is the constant term?"
  answer: {fileID: 11400000, guid: d9fbb72285ca51a289944e184d92be7a, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "The constant term has no variable."
  - "Only 9 has none."
