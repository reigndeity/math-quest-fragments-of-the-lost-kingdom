  act: 1
  difficulty: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Three times the sum of a number $x$ and 5, divided by the difference between $x$ and 2."
  answer: {fileID: 11400000, guid: 20987ad8b6a051d89449f36ae380a9a6, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "The top is 3 times the sum: $3(x+5)$."
  - "The bottom is the difference: $x-2$."
  - "Divide them: $\\frac{3(x+5)}{x-2}$."
