  act: 1
  difficulty: 1
  topic: "Components of Algebraic Expressions"
  question: "In the expression $9-4k+6k^2$ which term has the greatest coefficient?"
  answer: {fileID: 11400000, guid: 52a3a67f5ad44038a781245e87432a8e, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "The coefficients are the numbers in front of the variable parts."
  - "$6k^2$ has the greatest coefficient, $6$."
