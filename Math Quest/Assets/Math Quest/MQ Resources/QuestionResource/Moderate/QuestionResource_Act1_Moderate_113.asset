  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $4x^2y-3xy^2$ when $x=2$ and $y=3$."
  answer: {fileID: 11400000, guid: 51f7499bfe124339b0591eff35b7ede5, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace each letter with its value: $4(2)^2(3)-3(2)(3)^2$."
  - "Work it out step by step. The result is $-6$."
