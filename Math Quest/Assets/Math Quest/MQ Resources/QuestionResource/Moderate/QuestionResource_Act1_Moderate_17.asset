  m_Name: QuestionResource_Act1_Moderate_17
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $2(p+3q)$ when $p=5$ and $q=-1$."
  answer: {fileID: 11400000, guid: 29de6645623d5ebb82eb44022fb92397, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace $p$ with 5 and $q$ with $-1$: $2(5+3(-1))$."
  - "$2(5-3)=2(2)=4$."
