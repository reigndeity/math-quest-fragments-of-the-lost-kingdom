  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_2
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: Evaluating Algebraic Expressions
  question: "Evaluate the following algebraic expression when $a=-2$, $b=3$, and $c=5$: $3(b-a)^2-4c+a^3$"
  answer: {fileID: 11400000, guid: fbaf8946d9e74edd82020bd086505f3d, type: 2}
  encourageDialogue:
  - Spot on! You handled every sign correctly.
  tauntDialogue:
  - Hehehe... the signs tripped you up!
  solutionDialogue:
  - "Substitute a = -2, b = 3, and c = 5 into the expression."
  - "3(b - a)<sup>2</sup> = 3(3 - (-2))<sup>2</sup> = 3(5)<sup>2</sup> = 3(25) = 75."
  - "-4c = -4(5) = -20."
  - "a<sup>3</sup> = (-2)<sup>3</sup> = -8."
  - "Add everything together: 75 - 20 - 8 = 47."
