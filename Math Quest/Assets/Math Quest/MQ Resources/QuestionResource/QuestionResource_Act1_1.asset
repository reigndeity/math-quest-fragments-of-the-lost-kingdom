  m_Script: {fileID: 11500000, guid: 38a67493121d927458369348e77f5f07, type: 3}
  m_Name: QuestionResource_Act1_1
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: Evaluating Algebraic Expressions
  question: Evaluate $\frac{m^2-n^2}{m+n}+m^3$ when $m=-2$ and $n=5$.
  answer: {fileID: 11400000, guid: b21712eaeddc4539930ac851bcf27e08, type: 2}
  encourageDialogue:
  - Impressive! Every step was right.
  tauntDialogue:
  - Hehehe... watch those negative signs!
  solutionDialogue:
  - Substitute $m=-2$ and $n=5$ into the expression.
  - 'The fraction: $\frac{m^2-n^2}{m+n}=\frac{4-25}{-2+5}=\frac{-21}{3}=-7$.'
  - 'The cube: $m^3=(-2)^3=-8$.'
  - 'Add the two parts: $-7+(-8)=-15$.'
