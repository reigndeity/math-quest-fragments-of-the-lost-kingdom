  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: Components of Algebraic Expressions
  question: "What is the coefficient of $x$ in the expression $5x+3$?"
  answer: {fileID: 11400000, guid: 0ec8e9ce500d913418c55314b2ef2965, type: 2}
  encourageDialogue:
  - Correct! You spotted it right away.
  tauntDialogue:
  - Hehehe... not quite!
  solutionDialogue:
  - The coefficient is the number multiplied by the variable. / In 5x, the 5 multiplies
    x, so the coefficient of x is 5. The 3 is a constant term.
