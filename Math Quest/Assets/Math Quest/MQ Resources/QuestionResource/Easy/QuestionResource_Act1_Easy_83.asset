  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate: \"The product of six and a number $m$\""
  answer: {fileID: 11400000, guid: 3043f9d3894a4bb0a5464309bf0cdb1e, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
