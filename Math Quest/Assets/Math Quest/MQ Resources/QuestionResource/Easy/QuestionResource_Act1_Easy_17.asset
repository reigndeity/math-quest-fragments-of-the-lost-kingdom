  act: 1
  difficulty: 0
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate the verbal phrase into an algebraic expression: \"The sum of $m$ and 8\""
  answer: {fileID: 11400000, guid: acd20a163db1518fa8e7355f26d0f572, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Sum means add."
  - "The sum of $m$ and 8 is $m+8$."
