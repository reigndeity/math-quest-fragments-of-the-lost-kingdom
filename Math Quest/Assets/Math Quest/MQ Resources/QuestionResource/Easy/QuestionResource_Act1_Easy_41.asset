  topic: "Components of Algebraic Expressions"
  question: "What is the variable in the expression: $9x+12$?"
  answer: {fileID: 11400000, guid: 1f7bd1950fd94432bc9759449d837029, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "A variable is a letter that stands for an unknown number."
  - "In $9x+12$ that letter is $x$."
