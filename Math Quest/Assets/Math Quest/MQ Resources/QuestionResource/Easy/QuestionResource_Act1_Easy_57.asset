  act: 1
  difficulty: 0
  topic: "Classifying Algebraic Expressions"
  question: "Classify the expression $4y+6$ as monomial, binomial, or trinomial."
  answer: {fileID: 11400000, guid: d193ff89840141bbb90225657b473b94, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "A monomial has 1 term, a binomial 2 terms and a trinomial 3 terms."
  - "$4y+6$ has 2 terms, so it is binomial."
