  topic: "Components of Algebraic Expressions"
  question: "Identify the constant term in: $9-4y$."
  answer: {fileID: 11400000, guid: b9432dc9294e4124835e1ca6dba2c311, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "A constant term has no variable."
  - "In $9-4y$ it is $9$ (keep its sign)."
