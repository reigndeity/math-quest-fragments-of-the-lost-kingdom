  m_Name: QuestionResource_Act1_Easy_16
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate the verbal phrase into an algebraic expression: \"Five less than a number $n$\""
  answer: {fileID: 11400000, guid: 9d9370c26aae516ea10ac2edfdbac90c, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Less than flips the order."
  - "Five less than $n$ is $n-5$, not $5-n$."
