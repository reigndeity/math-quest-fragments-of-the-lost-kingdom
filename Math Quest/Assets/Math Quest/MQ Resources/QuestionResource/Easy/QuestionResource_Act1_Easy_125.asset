  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $3x+4y-6$ when $x=5$ and $y=3$."
  answer: {fileID: 11400000, guid: ede9d0bfd35a4a329133dddf597e0c85, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace each letter with its value: $3(5)+4(3)-6$."
  - "Work it out step by step. The result is $21$."
