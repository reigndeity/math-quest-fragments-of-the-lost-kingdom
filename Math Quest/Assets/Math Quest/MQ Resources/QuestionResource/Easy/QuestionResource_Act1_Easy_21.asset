  m_Name: QuestionResource_Act1_Easy_21
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Evaluating Algebraic Expressions"
  question: "If $x=2$ and $y=5$, what is $4x+2y-6$?"
  answer: {fileID: 11400000, guid: 66a1323c710b530991d068afa2348e93, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Replace $x$ with 2 and $y$ with 5: $4(2)+2(5)-6$."
  - "$8+10-6=12$."
