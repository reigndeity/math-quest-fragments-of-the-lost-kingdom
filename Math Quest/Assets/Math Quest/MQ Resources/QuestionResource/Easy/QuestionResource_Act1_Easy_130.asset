  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $4a+5b-7$ when $a=1$ and $b=4$."
  answer: {fileID: 11400000, guid: e0671fcd6a2e4046ad5047d0303e2fc8, type: 2}
  encourageDialogue:
  - "Hmph... correct. Lucky guess?"
