  m_Name: QuestionResource_Act1_Easy_20
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Components of Algebraic Expressions"
  question: "Identify the coefficients of $x$ and $y$ in the algebraic expression: $2x-8y+11$"
  answer: {fileID: 11400000, guid: 688af3b3ae6c558e83ae3033830dbfd6, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "The coefficient is the number in front of the variable."
  - "For $x$ it is 2, and for $y$ it is $-8$."
