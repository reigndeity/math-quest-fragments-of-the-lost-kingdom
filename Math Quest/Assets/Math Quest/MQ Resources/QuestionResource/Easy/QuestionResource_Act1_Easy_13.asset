  act: 1
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate the verbal phrase into an algebraic expression: \"Eight more than a number $x$\""
  answer: {fileID: 11400000, guid: 4128d6a1fae054ccacd4a04d1d65a1d5, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "More than means add."
  - "Eight more than $x$ is $x+8$."
