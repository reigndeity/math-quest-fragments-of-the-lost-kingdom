  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate: \"Five times a number $w$ minus eight\""
  answer: {fileID: 11400000, guid: 38321ad3666747ecb94f2b269eebbb6a, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
