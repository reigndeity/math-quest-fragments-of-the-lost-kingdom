  act: 1
  difficulty: 0
  topic: "Translating Verbal Phrases into Algebraic Expressions"
  question: "Translate: \"The difference between twice a number $f$ and nine\""
  answer: {fileID: 11400000, guid: 5b7ccec0da2846288afaa54a09826fbd, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "Turn each part of the phrase into math, then join the pieces."
  - "The expression is $2f-9$."
