  topic: Evaluating Algebraic Expressions
  question: Evaluate $9-2y$ when $y=3$.
  answer: {fileID: 11400000, guid: 96e2aa60717146a48a790b5b95c3bbeb, type: 2}
  askedByGuide: {fileID: 0}
