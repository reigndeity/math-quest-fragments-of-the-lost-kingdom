  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $5s$ when $s=4$."
  answer: {fileID: 11400000, guid: 17248ac220d6597ab179df3be6c08ff0, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
