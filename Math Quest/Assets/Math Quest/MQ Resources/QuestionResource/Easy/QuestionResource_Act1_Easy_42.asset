  topic: "Components of Algebraic Expressions"
  question: "Identify the coefficients of $x$ and $y$ in the algebraic expression: $4x-8y+10$"
  answer: {fileID: 11400000, guid: b623a90184834bff89b0f8720df3394f, type: 2}
