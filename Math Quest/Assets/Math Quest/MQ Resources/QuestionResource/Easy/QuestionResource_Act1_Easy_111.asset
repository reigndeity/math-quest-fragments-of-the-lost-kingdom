  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $2x+7y-5$ when $x=4$ and $y=2$."
  answer: {fileID: 11400000, guid: c1dd5bc9b8d74d98acff51cb1348929c, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "Replace each letter with its value: $2(4)+7(2)-5$."
  - "Work it out step by step. The result is $17$."
