  topic: "Evaluating Algebraic Expressions"
  question: "Evaluate $6c+8d-5$ when $c=3$ and $d=2$."
  answer: {fileID: 11400000, guid: 3added26fff943da9e8f0e06d5e279f9, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "Replace each letter with its value: $6(3)+8(2)-5$."
  - "Work it out step by step. The result is $29$."
