  topic: "Components of Algebraic Expressions"
  question: "Identify the constant term in: $6y-10$."
  answer: {fileID: 11400000, guid: ff10ab3da7c1483b997dc665fd69a8cc, type: 2}
  encourageDialogue:
  - "Correct! You are stronger than you look."
  tauntDialogue:
  - "Ha! Is that your best?"
  solutionDialogue:
  - "A constant term has no variable."
  - "In $6y-10$ it is $-10$ (keep its sign)."
