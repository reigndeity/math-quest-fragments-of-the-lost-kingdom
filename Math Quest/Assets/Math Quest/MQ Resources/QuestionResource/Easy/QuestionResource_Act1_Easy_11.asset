  act: 1
  topic: "Components of Algebraic Expressions"
  question: "Identify the variable in this algebraic expression: $6x+7$"
  answer: {fileID: 11400000, guid: 877b822c6102534ebd285bb98062a265, type: 2}
  encourageDialogue:
  - "Well done! You got it right."
  tauntDialogue:
  - "Nope! Not even close."
  solutionDialogue:
  - "A variable is a letter."
  - "In $6x+7$ the variable is $x$."
