  m_Name: QuestionResource_Act1_Easy_1
  m_EditorClassIdentifier: MathQuest.Runtime::MathQuest.Data.QuestionResource
  act: 1
  topic: "Components of Algebraic Expressions"
  question: "What is the variable in the expression: $5x+8$?"
  answer: {fileID: 11400000, guid: b796c17faa605791895f27c4e075d437, type: 2}
  encourageDialogue:
  - "Impressive! That is correct."
  tauntDialogue:
  - "Hehehe... that is not right!"
  solutionDialogue:
  - "A variable is a letter that stands for an unknown number."
  - "In $5x+8$ that letter is $x$."
